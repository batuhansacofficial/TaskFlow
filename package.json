{
  "name": "taskflow-api",
  "version": "1.0.0",
  "private": true,
  "description": "Görev ve sorumluluk takibi için REST API",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test test/*.test.js",
    "test:core": "node --test --test-name-pattern=Zorunlu test/api.test.js",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "express": "5.3.0"
  }
}
